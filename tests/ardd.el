;;; ardd.el --- ARDD bridge contract tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)

(ert-deftest mathbook-ardd-mirrors-selected-repl-without-changing-output ()
  (let ((mathbook-ardd-connection 'selected)
        (mathbook-ardd-busy nil)
        (mathbook-ardd-buffer " *Mathbook ARDD mirror test*"))
    (unwind-protect
        (with-temp-buffer
          (setq major-mode 'sly-mrepl-mode)
          (setq-local sly-buffer-connection 'selected)
          (setq-local comint-input-filter-functions nil)
          (setq-local comint-output-filter-functions nil)
          (mathbook-ardd--setup-repl)
          (run-hook-with-args 'comint-input-filter-functions "(values 2 3)")
          (let ((output (propertize "printed\n" 'face 'bold)))
            (should (eq output (mathbook-ardd--mirror-output output))))
          (dolist (value '("2" "3"))
            (run-hook-with-args 'comint-output-filter-functions
                                (propertize value 'sly-mrepl--result (list value))))
          (run-hook-with-args 'comint-output-filter-functions
                              (propertize "CL-USER> " 'sly-mrepl--prompt "cl-user"))
          (run-hook-with-args 'comint-output-filter-functions
                              "; Debugger entered on expected failure\n")
          (with-current-buffer mathbook-ardd-buffer
            (should (string-match-p "human/SLY" (buffer-string)))
            (should (string-match-p (regexp-quote "(values 2 3)") (buffer-string)))
            (should (string-match-p "printed\n=> 2\n=> 3\n" (buffer-string)))
            (should (string-match-p "Debugger entered on expected failure" (buffer-string)))
            (should-not (string-match-p "CL-USER>" (buffer-string)))
            (should-not (text-properties-at (point-min)))))
      (when (get-buffer mathbook-ardd-buffer) (kill-buffer mathbook-ardd-buffer)))))

(ert-deftest mathbook-ardd-mirroring-is-connection-local-and-not-duplicated ()
  (let ((mathbook-ardd-connection 'selected)
        (mathbook-ardd-busy nil)
        (mathbook-ardd-buffer " *Mathbook ARDD isolation test*"))
    (unwind-protect
        (with-temp-buffer
          (setq major-mode 'sly-mrepl-mode)
          (setq-local sly-buffer-connection 'selected)
          (setq-local comint-input-filter-functions nil)
          (setq-local comint-output-filter-functions nil)
          (mathbook-ardd--setup-repl)
          (mathbook-ardd--setup-repl)
          (should (= 1 (cl-count 'mathbook-ardd--mirror-input comint-input-filter-functions)))
          (let ((mathbook-ardd-busy t))
            (mathbook-ardd--mirror-input "duplicate input")
            (mathbook-ardd--mirror-output "duplicate output")
            (mathbook-ardd--mirror-result "duplicate result"))
          (should-not (get-buffer mathbook-ardd-buffer))
          (setq mathbook-ardd-connection 'another)
          (mathbook-ardd--mirror-input "unrelated connection")
          (mathbook-ardd--mirror-output "unrelated output")
          (mathbook-ardd--mirror-result "unrelated result")
          (should-not (get-buffer mathbook-ardd-buffer))
          (mathbook-ardd--setup-repl)
          (should-not (memq 'mathbook-ardd--mirror-input comint-input-filter-functions))
          (should-not (memq 'mathbook-ardd--mirror-result comint-output-filter-functions))
          (should-not (memq 'mathbook-ardd--mirror-output sly-mrepl-output-filter-functions)))
      (when (get-buffer mathbook-ardd-buffer) (kill-buffer mathbook-ardd-buffer)))))

(ert-deftest mathbook-ardd-pins-and-uses-the-selected-connection ()
  (let ((mathbook-ardd-connection nil)
        (mathbook-ardd-busy nil)
        (mathbook-ardd-buffer " *Mathbook ARDD test*")
        (connection 'selected)
        (reply t))
    (unwind-protect
        (cl-letf (((symbol-function 'sly-current-connection) (lambda () connection))
                  ((symbol-function 'process-live-p) (lambda (process) (eq process 'selected)))
                  ((symbol-function 'sly-connection-name) (lambda (_) "test"))
                  ((symbol-function 'display-buffer) #'ignore)
                  ((symbol-function 'mathbook-ardd-start-mailbox) #'ignore)
                  ((symbol-function 'sly-eval)
                   (lambda (_form _package)
                     (should (eq sly-dispatching-connection 'selected))
                     reply)))
          (mathbook-ardd-use-connection)
          (setq connection 'another-default
                reply '(:ok "printed\n" ("2" "3")))
          (should (equal (mathbook-ardd-eval "(values 2 3)")
                         "printed\n=> 2\n=> 3\n"))
          (with-current-buffer mathbook-ardd-buffer
            (should (string-match-p "(values 2 3)" (buffer-string)))
            (should (string-match-p "=> 3" (buffer-string)))))
      (when (get-buffer mathbook-ardd-buffer) (kill-buffer mathbook-ardd-buffer)))))

(ert-deftest mathbook-ardd-records-errors-and-can-evaluate-again ()
  (let ((mathbook-ardd-connection 'selected)
        (mathbook-ardd-busy nil)
        (mathbook-ardd-buffer " *Mathbook ARDD test*")
        (reply '(:error "before failure\n" "expected failure")))
    (unwind-protect
        (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
                  ((symbol-function 'sly-eval) (lambda (&rest _) reply)))
          (should-error (mathbook-ardd-eval "(error \"expected failure\")"))
          (should-not mathbook-ardd-busy)
          (setq reply '(:ok "" ("42")))
          (should (equal (mathbook-ardd-eval "42") "=> 42\n"))
          (with-current-buffer mathbook-ardd-buffer
            (should (string-match-p "before failure\nERROR: expected failure"
                                    (buffer-string)))))
      (when (get-buffer mathbook-ardd-buffer) (kill-buffer mathbook-ardd-buffer)))))

(ert-deftest mathbook-ardd-rejects-disconnected-or-overlapping-evaluation ()
  (let ((mathbook-ardd-connection nil))
    (should-error (mathbook-ardd-eval "42") :type 'user-error))
  (let ((mathbook-ardd-connection 'selected)
        (mathbook-ardd-busy t))
    (cl-letf (((symbol-function 'process-live-p) (lambda (_) t)))
      (should-error (mathbook-ardd-eval "42") :type 'user-error))))

(ert-deftest mathbook-ardd-evaluates-file-as-utf8-source ()
  (let ((file (make-temp-file "mathbook-ardd-test-"))
        (source "(format t \"λ\\n\")\n(values 2 3)"))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'utf-8))
            (write-region source nil file nil 'silent))
          (cl-letf (((symbol-function 'mathbook-ardd-eval)
                     (lambda (actual) (should (equal actual source)) "result")))
            (should (equal (mathbook-ardd-eval-file file) "result"))))
      (delete-file file))))

(ert-deftest mathbook-ardd-mailbox-claims-evaluates-and-replies ()
  (let* ((mathbook-ardd-mailbox-directory (make-temp-file "mathbook-mailbox-" t))
         (mathbook-ardd-mailbox-polling nil)
         (mathbook-ardd-busy nil)
         (id (make-string 32 ?a))
         (request (expand-file-name (concat "requests/" id ".json")
                                    mathbook-ardd-mailbox-directory))
         (reply (expand-file-name (concat "results/" id ".json")
                                  mathbook-ardd-mailbox-directory)))
    (unwind-protect
        (progn
          (dolist (directory '("requests" "results"))
            (make-directory (expand-file-name directory mathbook-ardd-mailbox-directory)))
          (write-region (json-encode `((source . "(+ 2 3)")
                                       (expires_at . ,(+ (float-time) 30))))
                        nil request nil 'silent)
          (cl-letf (((symbol-function 'mathbook-ardd-eval)
                     (lambda (source)
                       (should (equal source "(+ 2 3)"))
                       (should-not (file-exists-p request))
                       "=> 5\n")))
            (mathbook-ardd--poll))
          (let ((json-object-type 'alist))
            (should (equal (alist-get 'result (json-read-file reply)) "=> 5\n")))
          (should-not (file-exists-p (concat request ".running")))
          ;; Expired requests must not execute when Emacs wakes up later.
          (write-region (json-encode '((source . "(error \"must not run\")")
                                      (expires_at . 0)))
                        nil request nil 'silent)
          (cl-letf (((symbol-function 'mathbook-ardd-eval)
                     (lambda (_) (ert-fail "Expired request executed"))))
            (mathbook-ardd--poll))
          (let ((json-object-type 'alist))
            (should (string-match-p "expired" (alist-get 'error (json-read-file reply))))))
      (delete-directory mathbook-ardd-mailbox-directory t))))
