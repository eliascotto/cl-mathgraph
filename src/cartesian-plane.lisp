(in-package #:mathbook)

(defclass cartesian-plane ()
  ((width :initarg :width :initform 1024 :accessor plane-width)
   (height :initarg :height :initform 768 :accessor plane-height)
   (unit-spacing :initarg :unit-spacing :initform 60 :accessor plane-unit-spacing)
   (zoom :initarg :zoom :initform 1d0 :accessor plane-zoom)
   (center-x :initarg :center-x :initform 0d0 :accessor plane-center-x)
   (center-y :initarg :center-y :initform 0d0 :accessor plane-center-y)
   (grid-color :initarg :grid-color :initform :lightgray :accessor plane-grid-color)
   (color :initarg :color :initform :black :accessor plane-color))
  (:documentation "A Cartesian plane with drag panning and mouse-wheel zoom.
The center is stored in world coordinates, with positive y pointing upward.
UNIT-SPACING is the number of pixels per world unit at zoom 1."))

(defun pixels-per-unit (plane)
  (let ((base-spacing (plane-unit-spacing plane))
        (magnification (plane-zoom plane)))
    (check-type base-spacing (real (0) *))
    (check-type magnification (real (0) *))
    (* base-spacing magnification)))

(defun world-to-screen (plane x y)
  "Return two pixel coordinates for world X, Y, without rounding.
Positive world y points upward; positive screen y points downward."
  (let ((scale (pixels-per-unit plane)))
    (values (+ (/ (plane-width plane) 2) (* (- x (plane-center-x plane)) scale))
            (- (/ (plane-height plane) 2) (* (- y (plane-center-y plane)) scale)))))

(defun screen-to-world (plane x y)
  "Return two world coordinates for canvas pixel X, Y."
  (let ((scale (pixels-per-unit plane)))
    (values (+ (plane-center-x plane) (/ (- x (/ (plane-width plane) 2)) scale))
            (- (plane-center-y plane) (/ (- y (/ (plane-height plane) 2)) scale)))))

(defgeneric pan (plane delta-x delta-y)
  (:documentation "Move PLANE with a drag of DELTA-X and DELTA-Y canvas pixels."))

(defmethod pan ((plane cartesian-plane) delta-x delta-y)
  (check-type delta-x real)
  (check-type delta-y real)
  (let ((scale (pixels-per-unit plane)))
    (decf (plane-center-x plane) (/ delta-x scale))
    (incf (plane-center-y plane) (/ delta-y scale)))
  plane)

(defgeneric zoom (plane wheel-movement)
  (:documentation "Zoom PLANE in for positive wheel movement and out for negative movement."))

(defmethod zoom ((plane cartesian-plane) wheel-movement)
  (check-type wheel-movement real)
  (let ((current (plane-zoom plane)))
    (check-type current (real (0) *))
    ;; Clamp in logarithmic space so a large wheel event cannot overflow.
    (setf (plane-zoom plane)
          (exp (max (log 1d-6)
                    (min (log 1d6)
                         (+ (log (float current 1d0))
                            (* wheel-movement (log 1.15d0)))))))))

(defun plane-layout (plane)
  "Return the visible pixel origin, pixel tick spacing, and world tick step."
  (let ((scale (pixels-per-unit plane))
        (magnification (plane-zoom plane)))
    (let* ((target (/ 1d0 magnification))
           (decade (expt 10 (floor (log target 10d0))))
           (normalized (/ target decade))
           (step (* decade (cond ((< normalized (sqrt 2d0)) 1)
                                 ((< normalized (sqrt 10d0)) 2)
                                 ((< normalized (sqrt 50d0)) 5)
                                 (t 10)))))
      (multiple-value-bind (origin-x origin-y) (world-to-screen plane 0 0)
        (values (round origin-x) (round origin-y) (* scale step) step)))))

(defun axis-label (index step)
  "Format a tick value without float artifacts or unnecessary decimal zeroes."
  (let ((value (* index step)))
    (if (integerp value)
        (format nil "~D" value)
        (let ((places (loop for scaled = step then (* scaled 10)
                            until (integerp scaled)
                            count t)))
          (format nil "~,vF" places (float value 1d0))))))

(defgeneric grid (plane)
  (:documentation "Draw solid grid lines dividing each major cell into sixteen squares."))

(defmethod grid ((plane cartesian-plane))
  (multiple-value-bind (origin-x origin-y spacing) (plane-layout plane)
    (let ((width (plane-width plane))
          (height (plane-height plane))
          (color (plane-grid-color plane))
          (minor-color (raylib:make-rgba 235 235 235))
          (minor-spacing (/ spacing 4)))
      ;; Quarter spacing divides each major cell into a four-by-four grid.
      (loop for value from (ceiling (- origin-x) minor-spacing)
              to (floor (- (1- width) origin-x) minor-spacing)
            unless (zerop value)
              do (let ((x (round (+ origin-x (* value minor-spacing)))))
                   (raylib:draw-line x 0 x (1- height)
                                     (if (zerop (mod value 4)) color minor-color))))
      (loop for value from (ceiling (- origin-y (1- height)) minor-spacing)
              to (floor origin-y minor-spacing)
            unless (zerop value)
              do (let ((y (round (- origin-y (* value minor-spacing)))))
                   (raylib:draw-line 0 y (1- width) y
                                     (if (zerop (mod value 4)) color minor-color)))))))

(defgeneric axis (plane)
  (:documentation "Draw the axes, ticks, and adaptive labels of PLANE in an active Raylib frame."))

(defmethod axis ((plane cartesian-plane))
  (multiple-value-bind (origin-x origin-y spacing step) (plane-layout plane)
    (let ((width (plane-width plane))
          (height (plane-height plane))
          (color (plane-color plane))
          (font-size 12)
          (padding 8))
      (when (<= 0 origin-y (1- height))
        (raylib:draw-line 0 origin-y (1- width) origin-y color))
      (when (<= 0 origin-x (1- width))
        (raylib:draw-line origin-x 0 origin-x (1- height) color))
      (labels ((draw-label (text x y)
                 ;; Omit labels that would be clipped by the canvas edge.
                 (when (and (<= 0 x) (<= 0 y)
                            (<= (+ x (raylib:measure-text text font-size)) width)
                            (<= (+ y font-size) height))
                   (raylib:draw-rectangle (- x 2) (- y 2)
                                          (+ (raylib:measure-text text font-size) 4)
                                          (+ font-size 4) :white)
                   (raylib:draw-text text x y font-size color))))
        (when (and (<= 0 origin-x (1- width)) (<= 0 origin-y (1- height)))
          (draw-label "0" (- origin-x padding (raylib:measure-text "0" font-size))
                      (+ origin-y padding)))
        (loop for value from (ceiling (- origin-x) spacing)
                to (floor (- (1- width) origin-x) spacing)
              when (and (not (zerop value)) (<= 0 origin-y (1- height)))
                do (let* ((x (round (+ origin-x (* value spacing))))
                          (text (axis-label value step)))
                     (raylib:draw-line x (- origin-y 3) x (+ origin-y 3) color)
                     (draw-label text
                                 (- x (floor (raylib:measure-text text font-size) 2))
                                 (+ origin-y padding))))
        (loop for value from (ceiling (- origin-y (1- height)) spacing)
                to (floor origin-y spacing)
              when (and (not (zerop value)) (<= 0 origin-x (1- width)))
                do (let* ((y (round (- origin-y (* value spacing))))
                          (text (axis-label value step)))
                     (raylib:draw-line (- origin-x 3) y (+ origin-x 3) y color)
                     (draw-label text
                                 (- origin-x padding (raylib:measure-text text font-size))
                                 (- y (floor font-size 2)))))))))
